    </div>
    <div id="navbar-collapse-with-animation" class="hs-collapse hidden overflow-hidden transition-all duration-300 basis-full grow sm:block">
      <div class="flex flex-col gap-5 mt-5 sm:flex-row sm:items-center sm:justify-end sm:mt-0 sm:ps-5">
        <a class="font-bold text-gray-700 hover:text-blue-600 dark:text-gray-300 dark:hover:text-white transition-colors" href="/">Beranda</a>
        <a class="font-bold text-gray-700 hover:text-blue-600 dark:text-gray-300 dark:hover:text-white transition-colors" href="/scan">Scan</a>
        <a class="font-bold text-gray-700 hover:text-blue-600 dark:text-gray-300 dark:hover:text-white transition-colors" href="/dashboard">Dashboard</a>
        
        <!-- Theme Toggle Desktop -->
        <button onclick="toggleTheme()" class="hidden sm:inline-flex p-2 rounded-xl hover:bg-white/40 dark:hover:bg-slate-800/40 transition-all border border-transparent hover:border-white/50">
            <svg class="block dark:hidden w-5 h-5 text-gray-700" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"/></svg>
            <svg class="hidden dark:block w-5 h-5 text-yellow-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364-6.364l-.707.707M6.343 17.657l-.707.707m12.728 0l-.707-.707M6.343 6.343l-.707-.707M12 8a4 4 0 100 8 4 4 0 000-8z"/></svg>
